{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with paper trading balance and settings.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID of the user." },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "paperBalance": { "type": "number", "description": "Current paper trading balance in USD." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "paperBalance", "createdAt"]
    },
    "Trade": {
      "title": "Trade",
      "description": "Paper trade order and execution result.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID." },
        "signalId": { "type": "string", "maxLength": 64 },
        "symbol": { "type": "string", "maxLength": 32 },
        "market": { "type": "string", "enum": ["REAL", "OTC"] },
        "direction": { "type": "string", "enum": ["CALL", "PUT"] },
        "stakeUsd": { "type": "number" },
        "entryPrice": { "type": "number" },
        "exitPrice": { "type": "number" },
        "payoutRate": { "type": "number" },
        "profitUsd": { "type": "number" },
        "won": { "type": "boolean" },
        "status": { "type": "string", "enum": ["PENDING", "WON", "LOST"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "symbol", "direction", "stakeUsd", "status", "createdAt"]
    },
    "Signal": {
      "title": "Signal",
      "description": "Logged technical indicator signal snapshot.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID." },
        "signalId": { "type": "string", "maxLength": 64 },
        "symbol": { "type": "string", "maxLength": 32 },
        "market": { "type": "string", "enum": ["REAL", "OTC"] },
        "direction": { "type": "string", "enum": ["CALL", "PUT", "WAIT"] },
        "confidence": { "type": "number" },
        "timeframe": { "type": "string", "maxLength": 10 },
        "expirySeconds": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "signalId", "symbol", "direction", "confidence", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user paper account info and balance."
    },
    "/users/{userId}/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/Trade" },
      "description": "Stores paper trading transactions per user."
    },
    "/users/{userId}/signals/{signalId}": {
      "schema": { "$ref": "#/entities/Signal" },
      "description": "Stores historical signals generated by the user."
    }
  }
}
