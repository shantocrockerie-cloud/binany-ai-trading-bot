rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile & Settings
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId)
        && incoming().userId == userId
        && incoming().paperBalance is number
        && incoming().createdAt is string;
      allow update: if isOwner(userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().paperBalance is number;
      allow delete: if false;

      // Paper Trades Subcollection
      match /trades/{tradeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(tradeId)
          && incoming().userId == userId
          && incoming().symbol is string && incoming().symbol.size() <= 32
          && incoming().direction in ['CALL', 'PUT']
          && incoming().stakeUsd is number && incoming().stakeUsd > 0
          && incoming().status in ['PENDING', 'WON', 'LOST']
          && incoming().createdAt is string;
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().status in ['PENDING', 'WON', 'LOST'];
        allow delete: if isOwner(userId);
      }

      // Historical Generated Signals Subcollection
      match /signals/{signalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(signalId)
          && incoming().userId == userId
          && incoming().signalId is string
          && incoming().symbol is string && incoming().symbol.size() <= 32
          && incoming().direction in ['CALL', 'PUT', 'WAIT']
          && incoming().confidence is number
          && incoming().createdAt is string;
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }
  }
}
